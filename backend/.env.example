# Authentication Mode
# Use 'dev' for local development (skips real authentication)
# Use 'prod' for production environments with oauth2-proxy
AUTH_MODE=dev

# Admin Emails
# Comma-separated list of emails that should have admin access
ADMIN_EMAILS=admin@test.com,user@example.com

# Allowed Domains
# Comma-separated list of email domains allowed to access the application
ALLOWED_DOMAINS=@srmtech.com,@example.com
